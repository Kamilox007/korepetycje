# DOMAIN comes from .env. Caddy obtains and renews the Let's Encrypt certificate.
# If DNS does not point here yet, swap this for :80 to serve plain HTTP without a
# certificate. Do NOT leave it that way: the session token travels in the clear.
{$DOMAIN} {
	encode zstd gzip

	# API: everything under /api goes to the backend
	handle /api/* {
		reverse_proxy api:8000
	}

	# Frontend: everything else is a static file.
	# try_files falling back to index.html is required for the SPA; without it,
	# refreshing on any path other than / returns 404.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		# HSTS: the browser will refuse plain HTTP for a year.
		# Enable this ONLY once HTTPS works; backing it out is painful.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}
{$SITE_DOMAIN} {
	encode zstd gzip
	reverse_proxy site:80

	header {
		# Bez includeSubDomains — patrz uwaga niżej.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output file /var/log/caddy/site.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}

www.{$SITE_DOMAIN} {
	header Strict-Transport-Security "max-age=31536000"
	redir https://{$SITE_DOMAIN}{uri} permanent
}
