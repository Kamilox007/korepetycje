# Copy to .env and fill in. .env is NOT committed.

# --- application ---
DOMAIN=panel.your-domain.example
SITE_DOMAIN=your-domain.example
APP_ENV=prod

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Changing this invalidates every issued token (everyone is logged out).
JWT_SECRET=

# CORS is unnecessary while the frontend is served from the same domain,
# but it is kept here in case the frontend ever moves to its own host.
CORS_ORIGINS=https://panel.your-domain.example

DATABASE_URL=sqlite:////data/korepetycje.db

# --- backup (Backblaze B2, key scoped to a single bucket) ---
B2_KEY_ID=
B2_APP_KEY=

# --- bank transfer QR (optional) ---
# When both are set, the student panel shows a scannable transfer code.
# The account must be 26 digits; spaces and a leading PL are stripped.
BANK_ACCOUNT=
# Max 20 characters: the ZBP standard truncates longer names and some banks
# reject the code outright.
BANK_RECIPIENT=
# Only for businesses. Leave empty when invoicing as an individual.
BANK_NIP=
# Optional: shown as a BLIK alternative to the transfer QR. 9 digits, no +48.
BANK_BLIK_PHONE=
