# Databases must never end up in the image. DATABASE_URL points at /data, but
# COPY . . would pull the file into an image layer along with its data.
# The wildcard is *.db* on purpose: a name like korepetycje.db.old carries the
# extension in the middle, which plain *.db would miss.
*.db*
*.backup-*.db

# Environments and caches: pip rebuilds them inside the container
.venv
venv
__pycache__
*.pyc
.pytest_cache

# Tests are not run from the production image
test_*.py
testing_utils.py
requirements-dev.txt

# Development scripts
run.sh

.env
