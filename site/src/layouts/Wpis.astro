---
import Base from './Base.astro';

interface Props {
	title: string;
	opis: string;
	meta?: string;
	tagi?: string[];
	powrot: { href: string; label: string };
}

const { title, opis, meta, tagi = [], powrot } = Astro.props;
---

<Base title={`${title} — Kamil Krzywoń`} opis={opis}>
	<article>
		<h1>{title}</h1>
		{meta && <p class="mono cichy">{meta}</p>}
		{tagi.length > 0 && (
			<div class="znaczniki">
				{tagi.map((t) => <span class="znacznik">{t}</span>)}
			</div>
		)}
		<div class="tresc">
			<slot />
		</div>
	</article>
	<p style="margin-top:3rem"><a class="mono" href={powrot.href}>← {powrot.label}</a></p>
</Base>
