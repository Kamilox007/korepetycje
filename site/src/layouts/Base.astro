---
import '../styles/global.css';

interface Props {
	title: string;
	opis: string;
}

const { title, opis } = Astro.props;
const sciezka = Astro.url.pathname;
const kanon = new URL(sciezka, Astro.site).href;

const menu = [
	{ href: '/projekty', label: 'projekty' },
	{ href: '/blog', label: 'notatki' },
	{ href: '/cv', label: 'cv' },
	{ href: '/korepetycje', label: 'korepetycje' },
	{ href: '/kontakt', label: 'kontakt' },
];
---

<!doctype html>
<html lang="pl">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={opis} />
		<link rel="canonical" href={kanon} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="alternate" type="application/rss+xml" title="Notatki — Kamil Krzywoń" href="/rss.xml" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={opis} />
		<meta property="og:url" content={kanon} />
		<meta property="og:locale" content="pl_PL" />
		<meta name="twitter:card" content="summary" />
	</head>
	<body>
		<a class="pomin" href="#tresc">Przejdź do treści</a>
		<div class="arkusz">
			<header class="pasek">
				<a class="sygnatura" href="/">Kamil&nbsp;Krzywoń</a>
				<nav>
					{menu.map((p) => (
						<a href={p.href} aria-current={sciezka.startsWith(p.href) ? 'page' : undefined}>
							{p.label}
						</a>
					))}
				</nav>
			</header>

			<main id="tresc">
				<slot />
			</main>

			<footer class="stopka">
				<span>Kamil Krzywoń · {new Date().getFullYear()}</span>
				<span>
					<a href="/rss.xml">rss</a> · <a href="https://github.com/">github</a>
				</span>
			</footer>
		</div>
	</body>
</html>
