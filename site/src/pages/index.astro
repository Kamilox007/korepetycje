---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const projekty = (await getCollection('projekty', ({ data }) => !data.szkic))
	.sort((a, b) => a.data.kolejnosc - b.data.kolejnosc)
	.slice(0, 4);

const wpisy = (await getCollection('blog', ({ data }) => !data.szkic))
	.sort((a, b) => b.data.data.valueOf() - a.data.data.valueOf())
	.slice(0, 3);

const fmt = (d: Date) => d.toLocaleDateString('pl-PL', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Base
	title="Kamil Krzywoń — inżynieria uczenia maszynowego"
	opis="Student informatyki (AI). Buduję systemy uczące się i systemy produkcyjne, które muszą działać codziennie."
>
	<h1>Modele, które się uczą.<br />Systemy, które muszą działać.</h1>

	<p class="mono cichy">
		Informatyka, specjalność sztuczna inteligencja · dyplom 2026 · Python, PyTorch, FastAPI
	</p>

	<section class="streszczenie">
		<h2>Streszczenie</h2>
		<p>
			Kończę studia informatyczne ze specjalnością AI. Interesuje mnie miejsce, w którym uczenie
			maszynowe przestaje być notatnikiem z eksperymentem, a zaczyna być czymś, co ktoś uruchamia
			w poniedziałek rano i oczekuje, że zadziała.
		</p>
		<p>
			Równolegle prowadzę korepetycje z matematyki i fizyki — i napisałem do nich system,
			który dziś rozlicza wszystkich moich uczniów. To najlepszy dowód na to, jak pracuję:
			opisałem go poniżej ze szczegółami, łącznie z decyzjami, które okazały się błędne.
		</p>
	</section>

	<h2><span class="numer">1</span>Projekty</h2>
	<ul class="spis">
		{projekty.map((p) => (
			<li>
				<a href={`/projekty/${p.id}`}>
					<span class="meta">{p.data.stack.slice(0, 4).join(' · ')}</span>
					<span class="tytul">{p.data.title}</span>
					<span class="opis">{p.data.opis}</span>
				</a>
			</li>
		))}
	</ul>

	<h2><span class="numer">2</span>Notatki</h2>
	{wpisy.length === 0 ? (
		<p class="cichy">Jeszcze nic tu nie ma. Pierwszy wpis w przygotowaniu.</p>
	) : (
		<ul class="spis">
			{wpisy.map((w) => (
				<li>
					<a href={`/blog/${w.id}`}>
						<span class="meta">{fmt(w.data.data)}</span>
						<span class="tytul">{w.data.title}</span>
						<span class="opis">{w.data.opis}</span>
					</a>
				</li>
			))}
		</ul>
	)}

	<h2><span class="numer">3</span>Korepetycje</h2>
	<p>
		Uczę matematyki i fizyki — od podstaw po przygotowanie do matury.
		Uczniowie mają własne konto z terminarzem, historią lekcji i saldem.
	</p>
	<p>
		<a href="/korepetycje">Zasady i cennik</a> ·
		<a href="https://panel.kamilkrzywon.pl">Panel ucznia</a>
	</p>
</Base>
