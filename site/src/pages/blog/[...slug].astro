---
import Wpis from '../../layouts/Wpis.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const wpisy = await getCollection('blog', ({ data }) => !data.szkic);
	return wpisy.map((w) => ({ params: { slug: w.id }, props: { w } }));
}

const { w } = Astro.props;
const { Content } = await render(w);
const fmt = (d: Date) => d.toLocaleDateString('pl-PL', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Wpis
	title={w.data.title}
	opis={w.data.opis}
	meta={fmt(w.data.data)}
	tagi={w.data.tagi}
	powrot={{ href: '/blog', label: 'Wszystkie notatki' }}
>
	<Content />
</Wpis>
