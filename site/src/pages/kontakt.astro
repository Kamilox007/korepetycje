---
import Base from '../layouts/Base.astro';

const kontakty = [
	{ etykieta: 'E-mail', wartosc: 'kontakt@kamilkrzywon.pl', href: 'mailto:kontakt@kamilkrzywon.pl' },
	{ etykieta: 'GitHub', wartosc: 'github.com/Kamilox007', href: 'https://github.com/Kamilox007' },
	{ etykieta: 'LinkedIn', wartosc: 'linkedin.com/in/kamil-krzywoń', href: 'https://www.linkedin.com/in/kamil-krzywo%C5%84-349354314/' },
];
---

<Base title="Kontakt — Kamil Krzywoń" opis="Jak się ze mną skontaktować.">
	<h1>Kontakt</h1>
	<p>
		Najszybciej mailem. Odpisuję zwykle tego samego dnia.
	</p>

	<ul class="spis" style="margin-top:2rem">
		{kontakty.map((k) => (
			<li>
				<a href={k.href}>
					<span class="meta">{k.etykieta}</span>
					<span class="tytul">{k.wartosc}</span>
				</a>
			</li>
		))}
	</ul>

	<p class="mono cichy" style="margin-top:2.5rem">
		Sprawy uczniów i rozliczenia — przez <a href="https://panel.kamilkrzywon.pl">panel</a>.
	</p>
</Base>
