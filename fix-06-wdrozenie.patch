@@ -0,0 +1,19 @@
+# Skopiuj do .env i uzupełnij. .env NIE trafia do gita.
+
+# --- aplikacja ---
+DOMAIN=korepetycje.twoja-domena.pl
+APP_ENV=prod
+
+# Wygeneruj: python -c "import secrets; print(secrets.token_urlsafe(64))"
+# Zmiana tej wartości unieważnia wszystkie wydane tokeny (wszyscy się wylogują).
+JWT_SECRET=
+
+# Przy serwowaniu frontendu z tej samej domeny CORS nie jest potrzebny,
+# ale zostawiamy spójnie na wypadek osobnego hosta frontendu.
+CORS_ORIGINS=https://korepetycje.twoja-domena.pl
+
+DATABASE_URL=sqlite:////data/korepetycje.db
+
+# --- backup (Backblaze B2, klucz z uprawnieniem tylko do jednego bucketa) ---
+B2_KEY_ID=
+B2_APP_KEY=
