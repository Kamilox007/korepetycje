diff --git a/deploy/Caddyfile b/deploy/Caddyfile
new file mode 100644
index 0000000..fc968b3
--- /dev/null
+++ b/deploy/Caddyfile
@@ -0,0 +1,37 @@
+# DOMAIN pochodzi z .env. Caddy sam pobiera i odnawia certyfikat Let's Encrypt.
+# Jeśli DNS jeszcze nie wskazuje na serwer, podmień na :80 — wtedy działa po HTTP
+# bez certyfikatu, ale NIE zostawiaj tego na dłużej: token leci wtedy otwartym tekstem.
+{$DOMAIN} {
+	encode zstd gzip
+
+	# API — wszystko pod /api trafia do backendu
+	handle /api/* {
+		reverse_proxy api:8000
+	}
+
+	# Frontend — reszta to pliki statyczne.
+	# try_files z fallbackiem na index.html jest konieczne dla SPA: bez tego
+	# odświeżenie strony na dowolnym adresie innym niż / zwróci 404.
+	handle {
+		root * /srv
+		try_files {path} /index.html
+		file_server
+	}
+
+	header {
+		# HSTS — przeglądarka odmówi połączenia po HTTP przez rok.
+		# Włącz DOPIERO gdy HTTPS działa, bo cofnięcie jest bolesne.
+		Strict-Transport-Security "max-age=31536000; includeSubDomains"
+		X-Content-Type-Options "nosniff"
+		X-Frame-Options "DENY"
+		Referrer-Policy "strict-origin-when-cross-origin"
+		-Server
+	}
+
+	log {
+		output file /var/log/caddy/access.log {
+			roll_size 10MB
+			roll_keep 5
+		}
+	}
+}
diff --git a/deploy/litestream.yml b/deploy/litestream.yml
new file mode 100644
index 0000000..2c003d2
--- /dev/null
+++ b/deploy/litestream.yml
@@ -0,0 +1,14 @@
+# Replikacja bazy SQLite. Litestream zapisuje strumień WAL do bucketa,
+# więc utrata serwera oznacza utratę sekund danych, nie doby.
+dbs:
+  - path: /data/korepetycje.db
+    replicas:
+      - type: s3
+        # Backblaze B2 z S3-compatible API. Podmień bucket i region.
+        bucket: korepetycje-backup
+        path: db
+        endpoint: s3.eu-central-003.backblazeb2.com
+        region: eu-central-003
+        # Ile historii trzymać. 720h = 30 dni.
+        retention: 720h
+        snapshot-interval: 24h
diff --git a/docker-compose.yml b/docker-compose.yml
new file mode 100644
index 0000000..9b11d19
--- /dev/null
+++ b/docker-compose.yml
@@ -0,0 +1,54 @@
+services:
+  api:
+    build: ./backend
+    restart: unless-stopped
+    env_file: .env
+    volumes:
+      - db-data:/data
+    expose:
+      - "8000"
+    # Bez portu na hoście — do backendu wchodzi się wyłącznie przez Caddy.
+    healthcheck:
+      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/health')"]
+      interval: 30s
+      timeout: 5s
+      retries: 3
+      start_period: 20s
+
+  web:
+    build: ./frontend
+    restart: unless-stopped
+    depends_on:
+      - api
+    environment:
+      DOMAIN: ${DOMAIN}
+    ports:
+      - "80:80"
+      - "443:443"
+      - "443:443/udp"   # HTTP/3
+    volumes:
+      - ./deploy/Caddyfile:/etc/caddy/Caddyfile:ro
+      - caddy-data:/data       # certyfikaty — MUSI przetrwać restart,
+      - caddy-config:/config   # inaczej Let's Encrypt zablokuje za nadmiar żądań
+      - caddy-logs:/var/log/caddy
+
+  # Ciągła replikacja SQLite do Backblaze B2 / S3.
+  # Odtworzenie do dowolnego punktu w czasie, nie tylko do ostatniego snapshotu.
+  litestream:
+    image: litestream/litestream:0.3
+    restart: unless-stopped
+    depends_on:
+      - api
+    volumes:
+      - db-data:/data
+      - ./deploy/litestream.yml:/etc/litestream.yml:ro
+    environment:
+      LITESTREAM_ACCESS_KEY_ID: ${B2_KEY_ID}
+      LITESTREAM_SECRET_ACCESS_KEY: ${B2_APP_KEY}
+    command: replicate
+
+volumes:
+  db-data:
+  caddy-data:
+  caddy-config:
+  caddy-logs:
diff --git a/frontend/Dockerfile b/frontend/Dockerfile
new file mode 100644
index 0000000..0b26899
--- /dev/null
+++ b/frontend/Dockerfile
@@ -0,0 +1,12 @@
+# --- etap 1: build Reacta ---
+FROM node:22-alpine AS build
+WORKDIR /app
+COPY package.json ./
+RUN npm install
+COPY . .
+RUN npm run build
+
+# --- etap 2: Caddy z gotowymi plikami statycznymi ---
+# Obraz wynikowy nie zawiera Node'a ani node_modules — kilkadziesiąt MB zamiast kilkuset.
+FROM caddy:2-alpine
+COPY --from=build /app/dist /srv
